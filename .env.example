# Copy this file to `.env` and fill in real values. `.env` is gitignored and must never be committed.

# Generate a fresh one, e.g.: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# True locally, must be False in any deployed/shared environment
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated list of origins allowed to make cross-site requests (your frontend URL(s))
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://192.168.1.42:3001

# MySQL database
DB_NAME=erms_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Gmail SMTP (use a Google "App Password", never your real account password)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
